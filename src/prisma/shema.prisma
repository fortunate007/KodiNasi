generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LANDLORD
  TENANT
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String?
  password  String
  role      Role
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Int
  area        String
  bedrooms    Int
  images      String[]
  landlord    User     @relation(fields: [landlordId], references: [id])
  landlordId  Int
  createdAt   DateTime @default(now())
}